{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Async Research Review Panel",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "tier",
    "required_reviewers",
    "missing_required_reviews",
    "reviews",
    "aggregate_decision",
    "routing_reason",
    "human_gate_required",
    "escalation"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "prompt_versions": {
      "type": "object",
      "properties": {
        "primary_reviewer": {
          "type": "string"
        },
        "methodology_reviewer": {
          "type": "string"
        },
        "skeptic_reviewer": {
          "type": "string"
        },
        "review_aggregator": {
          "type": "string"
        }
      }
    },
    "framework_versions": {
      "type": "object",
      "properties": {
        "result_acceptance": {
          "type": "string"
        },
        "review_aggregation": {
          "type": "string"
        },
        "schema_versioning": {
          "type": "string"
        }
      }
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{4}$"
    },
    "tier": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reviewer_role",
          "decision",
          "claim_strength",
          "prompt_version",
          "framework_versions",
          "main_concerns",
          "confidence"
        ],
        "properties": {
          "reviewer_role": {
            "type": "string",
            "enum": [
              "primary",
              "methodology",
              "skeptic"
            ]
          },
          "decision": {
            "type": "string",
            "enum": [
              "accept",
              "accept_with_caveats",
              "needs_revision",
              "needs_human",
              "reject"
            ]
          },
          "claim_strength": {
            "type": "string",
            "enum": [
              "none",
              "weak",
              "suggestive",
              "moderate",
              "strong"
            ]
          },
          "prompt_version": {
            "type": "string"
          },
          "framework_versions": {
            "type": "object",
            "required": [
              "result_acceptance"
            ],
            "properties": {
              "result_acceptance": {
                "type": "string"
              },
              "review_aggregation": {
                "type": "string"
              },
              "schema_versioning": {
                "type": "string"
              }
            }
          },
          "main_concerns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_followups": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_gaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "escalate_to_tier": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 3
          },
          "escalation_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "required_reviewers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "primary",
          "methodology",
          "skeptic"
        ]
      }
    },
    "missing_required_reviews": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "primary",
          "methodology",
          "skeptic"
        ]
      }
    },
    "aggregate_decision": {
      "type": "string",
      "enum": [
        "accepted",
        "needs_revision",
        "needs_human",
        "paused",
        "rejected"
      ]
    },
    "routing_reason": {
      "type": "string"
    },
    "aggregate_claim_strength": {
      "type": "string",
      "enum": [
        "none",
        "weak",
        "suggestive",
        "moderate",
        "strong"
      ]
    },
    "claim_strength_policy": {
      "type": "string"
    },
    "revision_limit_hit": {
      "type": "boolean"
    },
    "agreements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disagreements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "human_gate_required": {
      "type": "boolean"
    },
    "escalation": {
      "type": "object",
      "required": [
        "requested",
        "target_tier",
        "reason"
      ],
      "properties": {
        "requested": {
          "type": "boolean"
        },
        "target_tier": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 3
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "requested_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "requested_at": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "rule_trace": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
