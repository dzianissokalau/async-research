{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "1.0",
  "framework_version": "mission_scoring_v1.0",
  "mission_id": "real_estate_research",
  "mission_policy_version": "real_estate_research_v1.0",
  "objective": "accepted, reproducible, evidence-backed real-estate research outputs per dollar, per human minute, and per data-risk unit",
  "last_reviewed": "2026-05-02",
  "score_scale": {
    "1": "absent, invalid, or unsafe",
    "2": "weak; major gaps remain",
    "3": "acceptable with explicit caveats",
    "4": "strong and reusable",
    "5": "excellent; should become a reference example"
  },
  "weights": {
    "decision_impact": 2.0,
    "data_availability": 1.5,
    "killability": 1.5,
    "feasibility": 1.0,
    "reuse_potential": 1.0,
    "novelty": 0.5,
    "robustness_risk": -2.0,
    "cost": -1.0
  },
  "dimension_map": {
    "decision_impact": [
      "decision_usefulness"
    ],
    "data_availability": [
      "quality_robustness",
      "feasibility"
    ],
    "killability": [
      "quality_robustness",
      "cost_efficiency",
      "autonomy"
    ],
    "feasibility": [
      "feasibility",
      "autonomy",
      "speed"
    ],
    "reuse_potential": [
      "cost_efficiency",
      "autonomy"
    ],
    "novelty": [
      "novelty"
    ],
    "robustness_risk": [
      "quality_robustness"
    ],
    "cost": [
      "cost_efficiency"
    ]
  },
  "promotion": {
    "normal": {
      "promotion_threshold": 14.0,
      "park_threshold": 9.0,
      "minimum_killability": 3,
      "max_promotions_per_week": 3
    },
    "budget_constrained": {
      "promotion_threshold": 16.0,
      "park_threshold": 11.0,
      "minimum_killability": 5,
      "max_promotions_per_week": 1
    }
  },
  "budget_pressure": {
    "threshold": 0.8,
    "default_mode": "normal",
    "constrained_mode": "budget_constrained"
  },
  "hard_gates": [
    "research_question_present",
    "data_path_identified",
    "minimum_viable_test_present",
    "baseline_or_comparison_present",
    "kill_reason_present",
    "minimum_killability_met",
    "direct_experiment_blocked"
  ],
  "human_approval_required_for": [
    "mission_policy_change",
    "public_or_high_stakes_claim",
    "expensive_compute_or_paid_data",
    "private_scraped_or_sensitive_data",
    "unsupported_strong_claim_override"
  ],
  "calibration": {
    "cadence": "monthly",
    "last_completed": null,
    "next_due": "2026-06-02",
    "required_inputs": [
      "accepted_outputs_index",
      "rejected_ideas",
      "cost_ledger",
      "review_panel_disagreements"
    ]
  }
}
