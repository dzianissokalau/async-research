{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Async Research Analysis Diagnostics",
  "type": "object",
  "required": [
    "schema_version",
    "framework_version",
    "generated_at",
    "run_id",
    "experiment_plan_id",
    "task_id",
    "missingness_checks",
    "join_quality_checks",
    "leakage_checks",
    "segment_diagnostics",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "framework_version": {
      "type": "string",
      "enum": [
        "analysis_diagnostics_v1.0"
      ]
    },
    "generated_at": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[0-9]{4}$"
    },
    "experiment_plan_id": {
      "type": "string",
      "pattern": "^EXP-[0-9]{4}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{4}$"
    },
    "missingness_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "scope",
          "affected_fields",
          "missing_rate",
          "status",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "affected_fields": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "missing_rate": {
            "type": "number",
            "minimum": 0
          },
          "threshold": {
            "type": [
              "number",
              "string"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "warn",
              "fail",
              "not_applicable"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "join_quality_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "left_source_id",
          "right_source_id",
          "join_keys",
          "unmatched_rate",
          "duplicate_key_rate",
          "status",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "left_source_id": {
            "type": "string",
            "pattern": "^DS-[0-9]{4}$"
          },
          "right_source_id": {
            "type": "string",
            "pattern": "^DS-[0-9]{4}$"
          },
          "join_keys": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "unmatched_rate": {
            "type": "number",
            "minimum": 0
          },
          "duplicate_key_rate": {
            "type": "number",
            "minimum": 0
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "warn",
              "fail",
              "not_applicable"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "leakage_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "planned_check_ref",
          "leakage_type",
          "status",
          "evidence",
          "reviewer_action_required"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "planned_check_ref": {
            "type": "string"
          },
          "leakage_type": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "warn",
              "fail",
              "not_applicable"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "reviewer_action_required": {
            "type": "boolean"
          }
        }
      }
    },
    "segment_diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "segment_name",
          "segment_value",
          "sample_size",
          "metric_name",
          "metric_value",
          "status",
          "notes"
        ],
        "properties": {
          "segment_name": {
            "type": "string"
          },
          "segment_value": {
            "type": "string"
          },
          "sample_size": {
            "type": "integer",
            "minimum": 0
          },
          "metric_name": {
            "type": "string"
          },
          "metric_value": {
            "type": [
              "number",
              "string"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "warn",
              "fail",
              "not_applicable"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "calibration_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "applicable",
          "status",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "applicable": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "warn",
              "fail",
              "not_applicable"
            ]
          },
          "metric_name": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "string"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "uncertainty_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "applicable",
          "status",
          "evidence"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "applicable": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "warn",
              "fail",
              "not_applicable"
            ]
          },
          "metric_name": {
            "type": "string"
          },
          "value": {
            "type": [
              "number",
              "string"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "limitation",
          "impact",
          "claim_boundary"
        ],
        "properties": {
          "limitation": {
            "type": "string"
          },
          "impact": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "unknown"
            ]
          },
          "claim_boundary": {
            "type": "string"
          },
          "mitigation": {
            "type": "string"
          }
        }
      }
    }
  }
}
