{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Async Research Analysis Robustness Checks",
  "type": "object",
  "required": [
    "schema_version",
    "framework_version",
    "generated_at",
    "run_id",
    "experiment_plan_id",
    "task_id",
    "planned_checks",
    "summary",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "framework_version": {
      "type": "string",
      "enum": [
        "analysis_robustness_v1.0"
      ]
    },
    "generated_at": {
      "type": "string"
    },
    "run_id": {
      "type": "string",
      "pattern": "^RUN-[0-9]{4}$"
    },
    "experiment_plan_id": {
      "type": "string",
      "pattern": "^EXP-[0-9]{4}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{4}$"
    },
    "planned_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "planned_check_ref",
          "check_family",
          "hypothesis",
          "status",
          "result",
          "decision_impact",
          "limitation"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "planned_check_ref": {
            "type": "string"
          },
          "check_family": {
            "type": "string",
            "enum": [
              "sensitivity",
              "placebo",
              "falsification",
              "ablation",
              "alternative_specification",
              "holdout",
              "segment_stability",
              "calibration",
              "uncertainty",
              "other"
            ]
          },
          "hypothesis": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "warn",
              "fail",
              "not_run",
              "not_applicable"
            ]
          },
          "result": {
            "type": "string"
          },
          "metric_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decision_impact": {
            "type": "string",
            "enum": [
              "supports_claim",
              "caps_claim",
              "blocks_claim",
              "requires_human",
              "none"
            ]
          },
          "limitation": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "overall_status",
        "strongest_supported_claim",
        "review_notes"
      ],
      "properties": {
        "overall_status": {
          "type": "string",
          "enum": [
            "pass",
            "warn",
            "fail",
            "incomplete"
          ]
        },
        "strongest_supported_claim": {
          "type": "string",
          "enum": [
            "none",
            "descriptive",
            "associative",
            "predictive",
            "causal",
            "probabilistic",
            "other"
          ]
        },
        "review_notes": {
          "type": "string"
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "limitation",
          "impact",
          "claim_boundary"
        ],
        "properties": {
          "limitation": {
            "type": "string"
          },
          "impact": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "unknown"
            ]
          },
          "claim_boundary": {
            "type": "string"
          },
          "mitigation": {
            "type": "string"
          }
        }
      }
    }
  }
}
