{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Async Research Experiment Plan",
  "type": "object",
  "required": [
    "schema_version",
    "experiment_id",
    "task_id",
    "framework_version",
    "hypothesis_id",
    "research_question",
    "decision_use_case",
    "target_outcome",
    "population",
    "geography",
    "time_period",
    "data_audit_refs",
    "dataset_versions",
    "inclusion_rules",
    "exclusion_rules",
    "feature_set",
    "baselines",
    "candidate_methods",
    "validation_design",
    "metrics",
    "leakage_checklist",
    "robustness_checks",
    "success_criteria",
    "failure_criteria",
    "budget",
    "stop_conditions",
    "outputs",
    "claim_limits",
    "scores"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^EXP-[0-9]{4}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{4}$"
    },
    "framework_version": {
      "type": "string",
      "enum": [
        "experimentation_v1.0"
      ]
    },
    "hypothesis_id": {
      "type": "string"
    },
    "research_question": {
      "type": "string"
    },
    "decision_use_case": {
      "type": "string"
    },
    "target_outcome": {
      "type": "string"
    },
    "population": {
      "type": "string"
    },
    "geography": {
      "type": "string"
    },
    "time_period": {
      "type": "object",
      "required": [
        "start",
        "end",
        "exclusion_lag"
      ],
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "exclusion_lag": {
          "type": "string"
        }
      }
    },
    "data_audit_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DS-[0-9]{4}$"
      }
    },
    "dataset_versions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "version",
          "accessed_at",
          "role"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^DS-[0-9]{4}$"
          },
          "version": {
            "type": "string"
          },
          "accessed_at": {
            "type": "string"
          },
          "role": {
            "type": "string"
          }
        }
      }
    },
    "inclusion_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exclusion_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "feature_set": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "source_id",
          "available_at",
          "leakage_risk"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "source_id": {
            "type": "string",
            "pattern": "^DS-[0-9]{4}$"
          },
          "available_at": {
            "type": "string"
          },
          "leakage_risk": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        }
      }
    },
    "baselines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "family",
          "implementation",
          "comparison_role"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "family": {
            "type": "string",
            "enum": [
              "naive_local_median",
              "prior_period_value",
              "geography_time_fixed_effects",
              "hedonic_regression_core_fields",
              "regularized_regression_benchmark",
              "other"
            ]
          },
          "implementation": {
            "type": "string"
          },
          "comparison_role": {
            "type": "string"
          }
        }
      }
    },
    "candidate_methods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "method_class",
          "why_candidate"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "method_class": {
            "type": "string"
          },
          "why_candidate": {
            "type": "string"
          }
        }
      }
    },
    "validation_design": {
      "type": "object",
      "required": [
        "time_split",
        "spatial_holdout_or_blocked_validation",
        "segment_level_error_analysis",
        "missingness_and_join_quality_checks",
        "leakage_review"
      ],
      "properties": {
        "time_split": {
          "type": "string"
        },
        "spatial_holdout_or_blocked_validation": {
          "type": "string"
        },
        "segment_level_error_analysis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missingness_and_join_quality_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "leakage_review": {
          "type": "string"
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "primary_metric",
        "secondary_metrics",
        "minimum_detectable_improvement"
      ],
      "properties": {
        "primary_metric": {
          "type": "string"
        },
        "secondary_metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "minimum_detectable_improvement": {
          "type": "string"
        }
      }
    },
    "leakage_checklist": {
      "type": "object",
      "required": [
        "feature_availability_before_prediction_date",
        "target_aggregates_train_only",
        "geography_summaries_time_safe",
        "publication_lags_modeled",
        "joins_point_in_time_or_versioned",
        "duplicate_or_repeat_transactions_handled"
      ],
      "properties": {
        "feature_availability_before_prediction_date": {
          "type": "string",
          "enum": [
            "pass",
            "caveat",
            "fail",
            "not_applicable"
          ]
        },
        "target_aggregates_train_only": {
          "type": "string",
          "enum": [
            "pass",
            "caveat",
            "fail",
            "not_applicable"
          ]
        },
        "geography_summaries_time_safe": {
          "type": "string",
          "enum": [
            "pass",
            "caveat",
            "fail",
            "not_applicable"
          ]
        },
        "publication_lags_modeled": {
          "type": "string",
          "enum": [
            "pass",
            "caveat",
            "fail",
            "not_applicable"
          ]
        },
        "joins_point_in_time_or_versioned": {
          "type": "string",
          "enum": [
            "pass",
            "caveat",
            "fail",
            "not_applicable"
          ]
        },
        "duplicate_or_repeat_transactions_handled": {
          "type": "string",
          "enum": [
            "pass",
            "caveat",
            "fail",
            "not_applicable"
          ]
        }
      }
    },
    "robustness_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_criteria": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "max_runtime_minutes",
        "max_api_usd",
        "max_compute_usd",
        "max_retries"
      ],
      "properties": {
        "max_runtime_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 240
        },
        "max_api_usd": {
          "type": "number",
          "minimum": 0
        },
        "max_compute_usd": {
          "type": "number",
          "minimum": 0
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "stop_conditions": {
      "type": "object",
      "required": [
        "stop_on_failure",
        "stop_on_budget_exceeded",
        "stop_on_data_quality_failure",
        "kill_criteria"
      ],
      "properties": {
        "stop_on_failure": {
          "type": "string"
        },
        "stop_on_budget_exceeded": {
          "type": "string"
        },
        "stop_on_data_quality_failure": {
          "type": "string"
        },
        "kill_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "required": [
        "output_dir",
        "run_manifest_path",
        "artifact_paths"
      ],
      "properties": {
        "output_dir": {
          "type": "string"
        },
        "run_manifest_path": {
          "type": "string"
        },
        "artifact_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "claim_limits": {
      "type": "object",
      "required": [
        "strongest_supported_claim",
        "causal_claim_allowed",
        "public_claim_allowed",
        "claim_limit_text"
      ],
      "properties": {
        "strongest_supported_claim": {
          "type": "string",
          "enum": [
            "exploratory",
            "descriptive",
            "predictive_improvement",
            "suggestive_association",
            "causal"
          ]
        },
        "causal_claim_allowed": {
          "type": "boolean"
        },
        "public_claim_allowed": {
          "type": "boolean"
        },
        "claim_limit_text": {
          "type": "string"
        }
      }
    },
    "scores": {
      "type": "object",
      "required": [
        "question_clarity",
        "data_readiness",
        "baseline_strength",
        "validation_design",
        "leakage_control",
        "robustness_design",
        "cost_realism",
        "decision_usefulness",
        "reproducibility",
        "claim_disciplined"
      ],
      "properties": {
        "question_clarity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "data_readiness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "baseline_strength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "validation_design": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "leakage_control": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "robustness_design": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "cost_realism": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "decision_usefulness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "reproducibility": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "claim_disciplined": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    }
  }
}
