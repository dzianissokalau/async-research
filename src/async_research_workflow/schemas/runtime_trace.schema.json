{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Async Research Runtime Trace",
  "type": "object",
  "required": [
    "schema_version",
    "framework_version",
    "trace_id",
    "task_id",
    "adapter_type",
    "tool_name",
    "input_summary",
    "output_summary",
    "artifact_paths",
    "return_code",
    "duration_ms",
    "token_usage",
    "cost",
    "error"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "framework_version": {
      "type": "string",
      "enum": [
        "runtime_trace_v1.0"
      ]
    },
    "trace_id": {
      "type": "string",
      "pattern": "^TRACE-[0-9]{6}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{4}$"
    },
    "adapter_type": {
      "type": "string",
      "enum": [
        "web_search",
        "web_open",
        "file_search",
        "file_fetch",
        "mcp_search",
        "mcp_fetch",
        "api_query",
        "code_execute"
      ]
    },
    "tool_name": {
      "type": "string",
      "pattern": ".+"
    },
    "input_summary": {
      "type": "string",
      "pattern": ".+"
    },
    "output_summary": {
      "type": "string",
      "pattern": ".+"
    },
    "artifact_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^research_ops/(?!.*\\.\\.).+"
      }
    },
    "return_code": {
      "type": "string",
      "pattern": ".+"
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0
    },
    "token_usage": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "basis"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "basis": {
          "type": "string",
          "pattern": ".+"
        }
      }
    },
    "cost": {
      "type": "object",
      "required": [
        "api_usd",
        "compute_usd",
        "basis"
      ],
      "properties": {
        "api_usd": {
          "type": "number",
          "minimum": 0
        },
        "compute_usd": {
          "type": "number",
          "minimum": 0
        },
        "basis": {
          "type": "string",
          "pattern": ".+"
        }
      }
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "code",
        "message",
        "category"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": ".+"
        },
        "message": {
          "type": "string",
          "pattern": ".+"
        },
        "category": {
          "type": "string",
          "enum": [
            "permission_blocker",
            "validation_error",
            "tool_error",
            "timeout",
            "cost_limit",
            "unknown"
          ]
        }
      }
    }
  }
}
