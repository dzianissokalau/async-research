{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Async Research Runtime Trace",
  "type": "object",
  "required": [
    "schema_version",
    "framework_version",
    "trace_id",
    "task_id",
    "adapter_type",
    "tool_name",
    "input_summary",
    "output_summary",
    "artifact_paths",
    "return_code",
    "duration_ms",
    "token_usage",
    "cost",
    "error"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "framework_version": {
      "type": "string",
      "enum": [
        "runtime_trace_v1.0"
      ]
    },
    "trace_id": {
      "type": "string",
      "pattern": "^TRACE-[0-9]{6}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{4}$"
    },
    "adapter_type": {
      "type": "string",
      "enum": [
        "web_search",
        "web_open",
        "file_search",
        "file_fetch",
        "mcp_search",
        "mcp_fetch",
        "api_query",
        "code_execute"
      ]
    },
    "tool_name": {
      "type": "string",
      "pattern": ".+"
    },
    "input_summary": {
      "type": "string",
      "pattern": ".+"
    },
    "output_summary": {
      "type": "string",
      "pattern": ".+"
    },
    "artifact_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^research_ops/(?!.*\\.\\.).+"
      }
    },
    "return_code": {
      "type": "string",
      "pattern": ".+"
    },
    "duration_ms": {
      "type": "number",
      "minimum": 0
    },
    "token_usage": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "basis"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "basis": {
          "type": "string",
          "pattern": ".+"
        }
      }
    },
    "cost": {
      "type": "object",
      "required": [
        "api_usd",
        "compute_usd",
        "basis"
      ],
      "properties": {
        "api_usd": {
          "type": "number",
          "minimum": 0
        },
        "compute_usd": {
          "type": "number",
          "minimum": 0
        },
        "basis": {
          "type": "string",
          "pattern": ".+"
        }
      }
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "code",
        "message",
        "category"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": ".+"
        },
        "message": {
          "type": "string",
          "pattern": ".+"
        },
        "category": {
          "type": "string",
          "enum": [
            "permission_blocker",
            "validation_error",
            "tool_error",
            "timeout",
            "cost_limit",
            "unknown"
          ]
        }
      }
    },
    "route_decision": {
      "type": "object",
      "required": [
        "selected_adapter",
        "selected_source_class",
        "rejected_alternatives",
        "reason",
        "cost_estimate",
        "freshness_expectation",
        "license_or_use_policy_note",
        "browser_fallback"
      ],
      "properties": {
        "selected_adapter": {
          "type": "string",
          "enum": [
            "web_search",
            "web_open",
            "file_search",
            "file_fetch",
            "mcp_search",
            "mcp_fetch",
            "api_query",
            "code_execute"
          ]
        },
        "selected_tool": {
          "type": "string"
        },
        "selected_source_class": {
          "type": "string",
          "enum": [
            "official_api",
            "authoritative_downloadable_data",
            "official_page",
            "reputable_third_party_database",
            "general_web_page",
            "user_provided_source"
          ]
        },
        "source_preference_rank": {
          "type": "integer",
          "minimum": 1
        },
        "source_preference_policy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rejected_alternatives": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "reason": {
          "type": "string",
          "pattern": ".+"
        },
        "cost_estimate": {
          "type": "object"
        },
        "freshness_expectation": {},
        "license_or_use_policy_note": {
          "type": "string"
        },
        "browser_fallback": {
          "type": "object",
          "required": [
            "used",
            "allowed_by_task_contract",
            "snapshot_required",
            "governance"
          ],
          "properties": {
            "used": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            },
            "allowed_by_task_contract": {
              "type": "boolean"
            },
            "snapshot_required": {
              "type": "boolean"
            },
            "governance": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
