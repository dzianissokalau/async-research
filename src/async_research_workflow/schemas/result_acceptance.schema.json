{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Async Research Result Acceptance",
  "type": "object",
  "required": [
    "schema_version",
    "framework_version",
    "task_id",
    "task_type",
    "evaluated_at",
    "route",
    "recommended_decision",
    "claim_strength",
    "max_claim_strength",
    "claim_strength_policy",
    "hard_gate_results",
    "scorecard",
    "reviewer_panel",
    "human_gate",
    "source_governance",
    "accepted_memory",
    "evidence_ledger",
    "rejection_logging",
    "followups",
    "review_notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "framework_version": {
      "type": "string",
      "enum": [
        "result_acceptance_v1.0"
      ]
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{4}$"
    },
    "task_type": {
      "type": "string"
    },
    "evaluated_at": {
      "type": "string"
    },
    "route": {
      "type": "string",
      "enum": [
        "accept_as_evidence",
        "accept_negative_result",
        "needs_revision",
        "needs_followup_test",
        "needs_human",
        "pause",
        "reject"
      ]
    },
    "recommended_decision": {
      "type": "string",
      "enum": [
        "ready",
        "usable_with_caveats",
        "needs_revision",
        "needs_human",
        "blocked",
        "reject"
      ]
    },
    "claim_strength": {
      "type": "string",
      "enum": [
        "none",
        "weak",
        "suggestive",
        "moderate",
        "strong"
      ]
    },
    "max_claim_strength": {
      "type": "string",
      "enum": [
        "none",
        "weak",
        "suggestive",
        "moderate",
        "strong"
      ]
    },
    "claim_strength_policy": {
      "type": "string"
    },
    "hard_gate_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gate",
          "passed",
          "reason"
        ],
        "properties": {
          "gate": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "scorecard": {
      "type": "object",
      "required": [
        "plan_compliance",
        "reproducibility",
        "baseline_comparison",
        "metric_validity",
        "validation_strength",
        "robustness_strength",
        "leakage_safety",
        "limitation_honesty",
        "decision_usefulness",
        "claim_discipline"
      ],
      "properties": {
        "plan_compliance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "reproducibility": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "baseline_comparison": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "metric_validity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "validation_strength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "robustness_strength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "leakage_safety": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "limitation_honesty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "decision_usefulness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "claim_discipline": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "reviewer_panel": {
      "type": "object",
      "required": [
        "aggregate_present",
        "aggregate_decision",
        "tier",
        "required_reviewers",
        "reviewer_count",
        "disagreement_present"
      ],
      "properties": {
        "aggregate_present": {
          "type": "boolean"
        },
        "aggregate_decision": {
          "type": [
            "string",
            "null"
          ]
        },
        "tier": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 3
        },
        "required_reviewers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewer_count": {
          "type": "integer",
          "minimum": 0
        },
        "disagreement_present": {
          "type": "boolean"
        }
      }
    },
    "human_gate": {
      "type": "object",
      "required": [
        "required",
        "satisfied",
        "reason"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "satisfied": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "source_governance": {
      "type": "object",
      "required": [
        "required",
        "source_ids",
        "ok",
        "warnings",
        "blocked"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^DS-[0-9]{4}$"
          }
        },
        "ok": {
          "type": "boolean"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "blocked": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "source_decisions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "audit_register": {
          "type": "string"
        }
      }
    },
    "accepted_memory": {
      "type": "object",
      "required": [
        "claim_type",
        "freshness_window_days",
        "next_recheck_date",
        "revalidation_status",
        "supersedes",
        "superseded_by"
      ],
      "properties": {
        "claim_type": {
          "type": "string"
        },
        "freshness_window_days": {
          "type": [
            "integer",
            "string"
          ]
        },
        "next_recheck_date": {
          "type": "string"
        },
        "revalidation_status": {
          "type": "string"
        },
        "supersedes": {
          "type": "string"
        },
        "superseded_by": {
          "type": "string"
        }
      }
    },
    "analysis_run": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "task_dir": {
          "type": "string"
        },
        "run_manifest_path": {
          "type": "string"
        },
        "run_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "experiment_plan_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "accepted_plan_task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "data_versions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "artifact_paths": {
          "type": "object"
        },
        "diagnostics": {
          "type": "object"
        },
        "claim_gates": {
          "type": "object"
        },
        "validation": {
          "type": "object"
        },
        "revalidation_triggers": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "evidence_ledger": {
      "type": "object",
      "required": [
        "required",
        "ledger_path",
        "logged",
        "evidence_link"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "ledger_path": {
          "type": "string"
        },
        "logged": {
          "type": "boolean"
        },
        "evidence_link": {
          "type": "string"
        }
      }
    },
    "rejection_logging": {
      "type": "object",
      "required": [
        "required",
        "log_path",
        "logged"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "log_path": {
          "type": "string"
        },
        "logged": {
          "type": "boolean"
        }
      }
    },
    "followups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reason",
          "required_artifact",
          "priority",
          "human_approval_needed",
          "required_before_memo_use"
        ],
        "properties": {
          "reason": {
            "type": "string"
          },
          "required_artifact": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "human_approval_needed": {
            "type": "boolean"
          },
          "required_before_memo_use": {
            "type": "boolean"
          }
        }
      }
    },
    "review_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
