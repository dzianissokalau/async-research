{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Async Research Task Status",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "type",
    "status",
    "previous_status",
    "last_transition_reason",
    "priority",
    "revision_count",
    "max_revisions",
    "revision_limit_hit",
    "allowed_paths",
    "max_minutes",
    "requires_human",
    "budget"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "prompt_versions": {
      "type": "object",
      "properties": {
        "planner": {
          "type": "string"
        },
        "discovery_scout": {
          "type": "string"
        },
        "worker": {
          "type": "string"
        },
        "primary_reviewer": {
          "type": "string"
        },
        "methodology_reviewer": {
          "type": "string"
        },
        "skeptic_reviewer": {
          "type": "string"
        },
        "deliverable_critic": {
          "type": "string"
        },
        "review_aggregator": {
          "type": "string"
        },
        "weekly_synthesizer": {
          "type": "string"
        },
        "health_monitor": {
          "type": "string"
        }
      }
    },
    "framework_versions": {
      "type": "object",
      "properties": {
        "mission_scoring": {
          "type": "string"
        },
        "idea_evaluation": {
          "type": "string"
        },
        "experimentation": {
          "type": "string"
        },
        "exploration": {
          "type": "string"
        },
        "result_acceptance": {
          "type": "string"
        },
        "review_aggregation": {
          "type": "string"
        },
        "accepted_outputs_index": {
          "type": "string"
        },
        "schema_versioning": {
          "type": "string"
        },
        "data_source_audit": {
          "type": "string"
        },
        "escalation_policy": {
          "type": "string"
        }
      }
    },
    "id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{4}$"
    },
    "title": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "literature_extract",
        "idea_discovery",
        "idea_dedupe",
        "idea_scoring",
        "batch_job",
        "batch_ingest",
        "hypothesis_card",
        "data_readiness",
        "experiment_plan",
        "code_patch",
        "run_analysis",
        "evaluate_results",
        "critic_review",
        "memo_section",
        "weekly_synthesis",
        "status_update",
        "admin"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "inbox",
        "ready_for_planning",
        "ready_for_worker",
        "in_progress",
        "awaiting_review",
        "single_review",
        "panel_review",
        "accepted",
        "needs_revision",
        "needs_human",
        "paused",
        "rejected",
        "synthesized"
      ]
    },
    "previous_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "inbox",
        "ready_for_planning",
        "ready_for_worker",
        "in_progress",
        "awaiting_review",
        "single_review",
        "panel_review",
        "accepted",
        "needs_revision",
        "needs_human",
        "paused",
        "rejected",
        "synthesized",
        null
      ]
    },
    "last_transition_reason": {
      "type": "string"
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "revision_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "max_revisions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "revision_limit_hit": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "lock_owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "lock_expires_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowed_tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allow_browsing": {
      "type": "boolean"
    },
    "allow_code_execution": {
      "type": "boolean"
    },
    "allow_network": {
      "type": "boolean"
    },
    "runtime_permissions": {
      "type": "object",
      "properties": {
        "max_calls": {
          "type": "integer",
          "minimum": 0
        },
        "max_api_usd": {
          "type": "number",
          "minimum": 0
        },
        "max_compute_usd": {
          "type": "number",
          "minimum": 0
        },
        "allowed_domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_api_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_mcp_servers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allow_credentials": {
          "type": "boolean"
        },
        "allow_paid_calls": {
          "type": "boolean"
        },
        "parallel_research": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_parallel_branches": {
              "type": "integer",
              "minimum": 2,
              "maximum": 12
            },
            "per_branch_max_calls": {
              "type": "integer",
              "minimum": 1
            },
            "per_branch_max_api_usd": {
              "type": "number",
              "minimum": 0
            },
            "per_branch_max_compute_usd": {
              "type": "number",
              "minimum": 0
            },
            "allowed_shapes": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "source_gathering",
                  "literature_extraction",
                  "market_map_slice",
                  "policy_jurisdiction_comparison",
                  "data_source_profiling"
                ]
              }
            },
            "merge_required": {
              "type": "boolean"
            },
            "no_direct_acceptance": {
              "type": "boolean"
            },
            "require_task_lock": {
              "type": "boolean"
            },
            "concurrency_key": {
              "type": "string"
            }
          }
        }
      }
    },
    "max_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 240
    },
    "max_turns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "model_tier": {
      "type": "string"
    },
    "review_policy": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "required_reviewers": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "primary",
              "methodology",
              "skeptic",
              "aggregator"
            ]
          }
        },
        "panel_required": {
          "type": "boolean"
        },
        "human_required_for_acceptance": {
          "type": "boolean"
        }
      }
    },
    "escalate_to_tier": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "maximum": 3
    },
    "escalation_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "escalation_requested_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "escalation_requested_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "requires_human": {
      "type": "boolean"
    },
    "data_audit_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^DS-[0-9]{4}$"
      }
    },
    "catalog_idea_id": {
      "type": "string",
      "pattern": "^IDEA-[0-9]{4}$"
    },
    "catalog_promotion": {
      "type": "object",
      "required": [
        "catalog_idea_id",
        "idempotency_key",
        "reserved_task_id",
        "reservation_policy"
      ],
      "properties": {
        "catalog_idea_id": {
          "type": "string",
          "pattern": "^IDEA-[0-9]{4}$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^IDEA-[0-9]{4}:(hypothesis_card|data_readiness|literature_extract|experiment_plan):[0-9a-f]{64}$"
        },
        "reserved_task_id": {
          "type": "string",
          "pattern": "^TASK-[0-9]{4}$"
        },
        "reservation_policy": {
          "type": "string"
        }
      }
    },
    "human_gate_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "human_gate": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "policy_version",
        "trigger",
        "triggered_at",
        "severity",
        "reason",
        "required_human_decision",
        "available_decisions",
        "default_safe_action",
        "retry_behavior",
        "ledger_update_behavior"
      ],
      "properties": {
        "policy_version": {
          "type": "string"
        },
        "trigger": {
          "type": "string"
        },
        "triggered_at": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "medium",
            "high",
            "critical"
          ]
        },
        "reason": {
          "type": "string"
        },
        "required_human_decision": {
          "type": "string"
        },
        "available_decisions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default_safe_action": {
          "type": "string"
        },
        "retry_behavior": {
          "type": "string"
        },
        "ledger_update_behavior": {
          "type": "string"
        },
        "triggered_triggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "max_api_usd",
        "max_compute_usd"
      ],
      "properties": {
        "max_api_usd": {
          "type": "number",
          "minimum": 0
        },
        "max_compute_usd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "result": {
      "type": "object",
      "properties": {
        "recommendation": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "ready",
            "usable_with_caveats",
            "needs_revision",
            "needs_human",
            "blocked",
            "reject",
            null
          ]
        },
        "claim_strength": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "none",
            "weak",
            "suggestive",
            "moderate",
            "strong",
            null
          ]
        },
        "claim_strength_stale": {
          "type": "boolean"
        },
        "claim_strength_revalidation_required": {
          "type": "boolean"
        },
        "claim_strength_revalidation_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "claim_strength_revalidated_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "claim_strength_policy": {
          "type": [
            "string",
            "null"
          ]
        },
        "claim_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "accepted_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "freshness_window_days": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "next_recheck_date": {
          "type": [
            "string",
            "null"
          ]
        },
        "revalidation_status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "current",
            "due",
            "stale",
            "scheduled",
            "revalidated",
            "superseded",
            "manual_review",
            null
          ]
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^DS-[0-9]{4}$"
          }
        },
        "caveats": {
          "type": [
            "array",
            "string",
            "null"
          ]
        },
        "supersedes": {
          "type": [
            "array",
            "string",
            "null"
          ]
        },
        "superseded_by": {
          "type": [
            "array",
            "string",
            "null"
          ]
        },
        "followup_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
